  "id": "displayblockhitboxes",
  "version": "${version}",
  "name": "Display Entity Hitboxes",
  "description": "Gives display entities highly accurate collisions and outlines at any scale for any item or block, with per entity collision settings.",
  "authors": [
    "tworoundcats"
  ],
  "license": "Apache-2.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.tworoundcats.displayblockhitboxes.DisplayBlockHitboxes"
    ],
    "client": [
      "net.tworoundcats.displayblockhitboxes.DisplayBlockHitboxesClient"
    ],
    "modmenu": [
      "net.tworoundcats.displayblockhitboxes.compat.DisplayBlockHitboxesModMenu"
    ]
  },
  "mixins": [
    "displayblockhitboxes.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  }
